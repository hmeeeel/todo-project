<nav class="ribbon">
  <% ribbon.forEach(function(day) { %>
    <a
      class="ribbon__day
        <%= day.dateStr === selectedDate
          ? 'ribbon__day--active'
          : ''
        %>
        <%= day.isToday
          ? 'ribbon__day--today'
          : ''
        %>"
      href="/?date=<%= day.dateStr %>&status=<%= status %>"
    >
      <span class="ribbon__weekday">
        <%= day.weekday %>
      </span>
      <span class="ribbon__number">
        <%= day.dayNumber %>
      </span>
    </a>
  <% }); %>
</nav>